# Copy this file to `.env` and fill in your real values.
# Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use. `gemini-1.5-flash` is fast + cheap and works
# well for clause-level extraction. Swap to `gemini-1.5-pro` if you need
# higher quality comparisons.
GEMINI_MODEL=gemini-1.5-flash

# Port the Express server listens on.
PORT=3001